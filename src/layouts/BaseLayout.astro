---
import GlassNav from "../components/GlassNav";
import "../styles/global.css";
import "katex/dist/katex.min.css";

const {
  title = "Iván García Mestiza — Mathematics",
  description = "Research, publications, talks, and mathematical writing.",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f5f1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href={`${baseUrl}images/icon.png`} />
  </head>
  <body>
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <GlassNav client:load />
    <main id="top">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <span>© {new Date().getFullYear()} Iván García Mestiza</span>
      <span><a href="mailto:ivan.garcia@cimat.mx">ivan.garcia@cimat.mx</a></span>
      <a href="#top">Back to top ↑</a>
    </footer>
  </body>
</html>
