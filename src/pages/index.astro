---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";

const publicationEntries = (await getCollection("publications")).sort((a, b) => b.data.year - a.data.year || a.data.sortOrder - b.data.sortOrder);
const publications = await Promise.all(publicationEntries.map(async (entry) => ({ ...entry, Content: (await render(entry)).Content })));
const talks = (await getCollection("talks")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const awards = (await getCollection("awards")).sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
const researchEntries = (await getCollection("research")).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const research = await Promise.all(researchEntries.map(async (entry) => ({ ...entry, Content: (await render(entry)).Content })));
const blog = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const statusLabel = {
  published: "Published",
  preprint: "Preprint",
  "in-preparation": "In preparation",
  thesis: "Thesis"
};
---
<BaseLayout>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-dot"></span> Mathematician · Probability & Statistics</p>
      <h1>Iván García<br /><em>Mestiza</em></h1>
      <p class="hero-lede">
        I am interested in probability theory and stochastic processes, especially
        their connections with partial differential equations and mathematical finance.
      </p>
      <div class="hero-actions">
        <a class="button button-dark" href="#research">Explore my research <span>↘</span></a>
        <a class="text-link" href="/cv.pdf" target="_blank" rel="noreferrer">Curriculum vitae ↗</a>
      </div>
      <div class="hero-meta">
        <span><i class="meta-line"></i> Based in Guanajuato, Mexico</span>
        <!-- <span>Open to academic collaboration</span> -->
      </div>
    </div>
    <div class="portrait-wrap">
      <div class="portrait-glass">
        <img src="/images/profile-photo.jpg" alt="Portrait photograph" />
        <div class="portrait-caption">
          <span class="caption-label">CURRENTLY WORKING ON</span>
          <span>Probability · Stochastic processes</span>
        </div>
      </div>
      <div class="portrait-orbit orbit-a"></div>
      <div class="portrait-orbit orbit-b"></div>
      <!-- <span class="hero-index">01 / 06</span> -->
    </div>
  </section>

  <section id="about" class="about-band">
    <div class="wrap about-grid">
      <p class="eyebrow">A little about me</p>
      <div>
        <p class="about-statement">
          I am a mathematician from Veracruz, Mexico, with a background in
          <span>probability and statistics</span>. My work explores stochastic
          models and the analytical structures behind them.
        </p>
        <p class="body-copy">
          I completed my M.Sc. in Probability and Statistics at CIMAT, where my
          thesis focused on portfolio optimization under dynamic preferences.
          I am particularly interested in Markov processes, Lévy processes,
          diffusion theory, and the interplay between stochastic processes and PDEs.
        </p>
        <div class="about-facts">
          <div><span class="fact-label">EDUCATION</span><strong>M.Sc. Probability & Statistics</strong><small>CIMAT · Mexico</small></div>
          <div><span class="fact-label">RESEARCH</span><strong>Probability & stochastic analysis</strong><small>With connections to PDEs and finance</small></div>
          <div><span class="fact-label">LANGUAGES</span><strong>Spanish · English</strong><small>Native · Advanced</small></div>
        </div>
      </div>
    </div>
  </section>

  <section id="research" class="section wrap">
    <SectionHeading eyebrow="01 — Research" title="Questions I think about" description="A selection of themes that currently shape my mathematical interests." />
    <div class="research-grid">
      {research.map((item, i) => (
        <article class="research-card glass-card">
          <span class="card-number">0{i + 1}</span>
          <h3>{item.data.title}</h3>
          <div class="prose"><item.Content /></div>
          <span class="status">{item.data.status}</span>
        </article>
      ))}
    </div>
  </section>

  <section id="publications" class="section section-tint">
    <div class="wrap">
      <SectionHeading eyebrow="02 — Selected work" title="Publications & preprints" description="Research papers, preprints, and work in progress." />
      <div class="item-list">
        {publications.map((item) => (
          <article class="list-item">
            <div class="item-year">{item.data.year}</div>
            <div class="item-main">
              <div class="item-topline"><span class="status">{statusLabel[item.data.status]}</span>{item.data.venue && <span class="muted">{item.data.venue}</span>}</div>
              <h3>{item.data.title}</h3>
              <p class="item-authors">{item.data.authors.join(", ")}</p>
              <div class="item-links">
                {item.data.preprintUrl && <a href={item.data.preprintUrl} target="_blank" rel="noreferrer">Preprint ↗</a>}
                {item.data.articleUrl && <a href={item.data.articleUrl} target="_blank" rel="noreferrer">Published article ↗</a>}
                {item.data.doi && <a href={`https://doi.org/${item.data.doi}`} target="_blank" rel="noreferrer">DOI ↗</a>}
              </div>
              <details class="abstract-details">
                <summary>Abstract / details</summary>
                <div class="prose"><item.Content /></div>
              </details>
            </div>
            <span class="item-arrow">↗</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="talks" class="section wrap">
    <SectionHeading eyebrow="03 — Academic activity" title="Talks & presentations" description="Seminars, conferences, and invited presentations." />
    <div class="talk-grid">
      {talks.map((item) => (
        <article class="talk-card glass-card">
          <div class="talk-date">
            <span>{item.data.date.toLocaleString("en", { month: "short" })}</span>
            <strong>{item.data.date.getFullYear()}</strong>
          </div>
          <div class="talk-content">
            <h3>{item.data.title}</h3>
            <p>{item.data.event}</p>
            {item.data.location && <span class="muted">{item.data.location}</span>}
            <div class="item-links">
              {item.data.slidesUrl && <a href={item.data.slidesUrl} target="_blank" rel="noreferrer">Slides ↗</a>}
              {item.data.recordingUrl && <a href={item.data.recordingUrl} target="_blank" rel="noreferrer">Recording ↗</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="awards" class="section section-tint">
    <div class="wrap">
      <SectionHeading eyebrow="04 — Recognition" title="Grants & awards" description="Scholarships, academic distinctions, and other recognitions." />
      <div class="awards-list">
        {awards.map((item) => (
          <article class="award-row">
            <div class="award-date">{item.data.date ? item.data.date.getFullYear() : "—"}</div>
            <div><h3>{item.data.title}</h3><p>{item.data.organization}</p>{item.data.description && <small>{item.data.description}</small>}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="writing" class="section wrap">
    <SectionHeading eyebrow="05 — Writing" title="Notes & expository writing" description="A space for mathematical notes, lecture notes, and expository articles. New entries can be added as Markdown files." />
    <div class="writing-grid">
      <div class="writing-panel glass-card">
        <div class="writing-icon">∫</div>
        <h3>Blog & expository articles</h3>
        <p>Explanations, mathematical ideas, and occasional reflections on research.</p>
        {blog.length > 0 ? <ul>{blog.map((post) => <li><a href={`/blog/${post.id}/`}>{post.data.title} ↗</a></li>)}</ul> : <span class="coming-soon">Articles coming soon</span>}
      </div>
      <div class="writing-panel glass-card">
        <div class="writing-icon">∑</div>
        <h3>Mathematical notes</h3>
        <p>Lecture notes, derivations, useful references, and technical material.</p>
        {notes.length > 0 ? <ul>{notes.map((note) => <li><a href={`/notes/${note.id}/`}>{note.data.title} ↗</a></li>)}</ul> : <span class="coming-soon">Notes coming soon</span>}
      </div>
    </div>
  </section>

  <section class="contact-section">
    <div class="wrap contact-inner">
      <p class="eyebrow">Get in touch</p>
      <h2>Have a question or<br /><em>a mathematical idea?</em></h2>
      <a class="button button-light" href="mailto:your.email@example.com">Write to me <span>↗</span></a>
    </div>
  </section>
</BaseLayout>
